{
  "name": "bristlecone/bristlecone-markdown",
  "description": "Markdown for WordPress without Jetpack, with iA Writer-aligned syntax.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://bristleconeit.com/bristlecone-markdown",
  "support": {
    "issues": "https://github.com/Zyniker13/bits-wp-markdown/issues",
    "source": "https://github.com/Zyniker13/bits-wp-markdown"
  },
  "require": {
    "php": ">=8.4.1",
    "league/commonmark": "^2.7",
    "scrivo/highlight.php": "^9.18",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Bristlecone\\Markdown\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bristlecone\\Markdown\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "release": "@php bin/build-release.php"
  }
}
